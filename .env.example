# Copy to .env and fill in real values. Full reference: docs/ENV_VARS.md

# --- Required ---
PA_PROVIDER=openrouter                 # openrouter | anthropic | openai | gemini
PA_MODEL=replace-with-exact-model-id   # personal-agent --models <provider>

# --- Required for the selected Provider only ---
OPENROUTER_API_KEY=sk-or-...
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...

# --- Optional ---
PA_MAX_TOOL_ROUNDS=50
PA_CONTEXT_BUDGET_TOKENS=250000
PA_CONTEXT_CAPACITY_OVERRIDES=[]
# Exact route example (replace the model ID):
# PA_CONTEXT_CAPACITY_OVERRIDES=[{"provider":"openai","model":"exact-model-id","total_tokens":250000,"input_tokens":230000,"output_tokens":16000}]
# PA_MAX_READ_BYTES=32768
# PA_MAX_WRITE_BYTES=1048576
# PA_DETAILED_AUDIT=1
# PA_OPENROUTER_PROVIDER_DIAGNOSTICS=1
# PA_MEMORY_PATH=~/.personal_agent/memory.jsonl
# PA_ENABLE_SHELL=0
# PA_SHELL_TIMEOUT_SECONDS=30
# PA_SHELL_MAX_OUTPUT_BYTES=32768
# TAVILY_API_KEY=tvly-...             # optional websearch; each approved basic query costs one API credit
# PA_MCP_SERVER='{"name":"notes","command":"/path/to/server","args":["--stdio"]}'
# NO_COLOR=1
